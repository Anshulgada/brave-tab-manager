# ==============================================================================
# Tabman Environment Configuration
# ==============================================================================
# Copy this file to `.env` or set these variables in your shell environment.
# Never commit real API keys to version control.
# For local CLI use, you can also store secrets securely via `tabman config set-key`.

# ------------------------------------------------------------------------------
# 1. Local AI & Hugging Face Models (Official Tabman Embedding Engine)
# ------------------------------------------------------------------------------
# Tabman runs fine-tuned EmbeddingGemma 2 local models directly in-browser via
# WebGPU, NPU (DirectML / WebNN), or CPU WASM SIMD with zero cloud dependencies.

# Optional: Hugging Face user access token (for higher rate limits or private model repos)
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# HUGGINGFACE_API_KEY=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model storage directory on disk for downloaded ONNX weights & tokenizers
# Defaults:
#   Windows: %LOCALAPPDATA%\tabman\models
#   Linux/macOS: ~/.local/share/tabman/models
# TABMAN_MODELS_DIR=C:\Users\username\AppData\Local\tabman\models

# Preferred local compute device: auto | webgpu | webgpu-discrete | webgpu-integrated | npu | cpu
# TABMAN_COMPUTE_DEVICE=auto

# Model weight precision: int8 (recommended: 75% smaller, 3x faster) | fp32
# TABMAN_MODEL_PRECISION=int8

# ------------------------------------------------------------------------------
# 2. Local AI Endpoints (Ollama, LM Studio, LocalAI)
# ------------------------------------------------------------------------------
# Connect locally running open-weight LLMs with zero telemetry or data leaks.

# Ollama local daemon endpoint (default: http://127.0.0.1:11434)
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2

# OpenAI-compatible local servers (e.g., LM Studio, vLLM, LocalAI)
# LOCAL_AI_BASE_URL=http://127.0.0.1:1234/v1
# LOCAL_AI_MODEL=mistral-nemo-instruct

# ------------------------------------------------------------------------------
# 3. Remote Cloud AI Providers (Optional)
# ------------------------------------------------------------------------------
# If you prefer cloud-hosted LLM categorization or clustering:

# Google Gemini API key
# GEMINI_API_KEY=AIzaSy...

# Mistral AI API key
# MISTRAL_API_KEY=...

# OpenAI API key (for GPT-4o, text-embedding-3-small, etc.)
# OPENAI_API_KEY=sk-...

# Anthropic API key (for Claude 3.5 Sonnet / Haiku)
# ANTHROPIC_API_KEY=sk-ant-...

# Custom OpenAI-compatible or Anthropic-compatible provider API keys:
# Pattern: TABMAN_<PROVIDER_SLUG>_API_KEY (e.g., TABMAN_GROQ_API_KEY)
# TABMAN_GROQ_API_KEY=gsk_...
# TABMAN_OPENROUTER_API_KEY=sk-or-...

# ------------------------------------------------------------------------------
# 4. Rich Link & Metadata Previews (Iframely)
# ------------------------------------------------------------------------------
# Powers Raindrop.io-style visual cards with responsive thumbnail covers,
# site favicons, and metadata summaries. Previews are cached locally in IndexedDB.
# Get a personal key at: https://iframely.com
# IFRAMELY_API_KEY=...

# ------------------------------------------------------------------------------
# 5. Browser Automation & CDP Capture
# ------------------------------------------------------------------------------
# Chrome DevTools Protocol port for live tab capture from running Chromium/Brave instances.
# Default: 9222 (http://127.0.0.1:9222)
# CDP_PORT=9222
# CDP_HOST=127.0.0.1
